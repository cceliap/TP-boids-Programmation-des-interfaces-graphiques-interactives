#include <iostream>
#include <glad/glad.h>
#include <GLFW/glfw3.h>

// Shaders (programmes qui tournent sur la carte graphique)
const char* vertexShaderSource = R"( 
    #version 330 core
    layout (location = 0) in vec2 aPos;
    uniform vec2 position;
    void main() {
        gl_Position = vec4(aPos + position, 0.0, 1.0);
    }
)";
//deplacer/changer de taille... d'un objet, projeter 3D->2D

const char* fragmentShaderSource = R"(
    #version 330 core
    out vec4 FragColor;
    void main() {
        FragColor = vec4(1.0, 1.0, 1.0, 1.0); // blanc
    }
)";
//mets de la couleur, texture, lumière

int main() {
    // Initialisation GLFW
    glfwInit();
    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);

    //Creation de la fenetre
    GLFWwindow* window = glfwCreateWindow(800, 600, "Boids", NULL, NULL);
    glfwMakeContextCurrent(window); //on associe le contexte OpenGL à cette fenetre
    gladLoadGLLoader((GLADloadproc)glfwGetProcAddress); //récupère les adresses des fonctions OpenGL à partir du contexte créé par GLFW
    glViewport(0, 0, 800, 600); //Définit la zone de la fenêtre où OpenGL dessine (coin bas gauche, taille)

    // Compilation des shaders
    unsigned int vertexShader = glCreateShader(GL_VERTEX_SHADER);
    glShaderSource(vertexShader, 1, &vertexShaderSource, NULL);
    glCompileShader(vertexShader);

    unsigned int fragmentShader = glCreateShader(GL_FRAGMENT_SHADER);
    glShaderSource(fragmentShader, 1, &fragmentShaderSource, NULL);
    glCompileShader(fragmentShader);

    unsigned int shaderProgram = glCreateProgram();
    glAttachShader(shaderProgram, vertexShader);
    glAttachShader(shaderProgram, fragmentShader);
    glLinkProgram(shaderProgram);
    glDeleteShader(vertexShader);
    glDeleteShader(fragmentShader);

    // Triangle (forme d'un boid)
    float vertices[] = {
        0.0f,  0.02f,  // sommet haut
       -0.01f, -0.02f, // bas gauche
        0.01f, -0.02f  // bas droite
    };


    //Le VBO contient les données brutes,
    //le VAO contient la manière de les lire.
    unsigned int VAO, VBO;
    glGenVertexArrays(1, &VAO);
    glGenBuffers(1, &VBO);
    glBindVertexArray(VAO);
    glBindBuffer(GL_ARRAY_BUFFER, VBO);
    glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);
    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(float), (void*)0);
    glEnableVertexAttribArray(0);

    // Boucle principale
    while (!glfwWindowShouldClose(window)) {
        glClearColor(0.1f, 0.1f, 0.1f, 1.0f); //définit la couleur de fond
        glClear(GL_COLOR_BUFFER_BIT); //efface le buffer couleur avec cette couleur

        glUseProgram(shaderProgram);
        // Position du boid au centre
        glUniform2f(glGetUniformLocation(shaderProgram, "position"), 0.0f, 0.0f); //On fixe l’uniforme position à (0,0)
        glBindVertexArray(VAO);
        glDrawArrays(GL_TRIANGLES, 0, 3);

        glfwSwapBuffers(window);
        glfwPollEvents();
    }

    glfwTerminate();
    return 0;
}
